# Copy this file to .env and fill in values. Never commit .env.

# Optional: AI explanations on the Advisor page. Free-tier providers (pick one):
#   groq        key: https://console.groq.com/keys
#   gemini      key: https://aistudio.google.com/apikey
#   openrouter  key: https://openrouter.ai/keys   (use ":free" models)
KAIRO_AI_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional: override the model if a provider retires the default.
# KAIRO_MODEL=

# Optional: only for the GPM rainfall download scripts (earthaccess).
# Free account at https://urs.earthdata.nasa.gov/
# EARTHDATA_USERNAME=
# EARTHDATA_PASSWORD=
